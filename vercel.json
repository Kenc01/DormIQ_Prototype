{
  "buildCommand": "cd artifacts/dorm-app && pnpm run build && mkdir -p ../../dist && cp -a dist/public/. ../../dist/",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BASE_PATH": "/"
  }
}
